rules_version = '2';

// RETIRED. This repo shares the Firestore database of the Novota ERP (project invoice-app-6bb6f), whose rules
// live in Invoice-Digitizer/firestore.rules. The test-mode rules that used to be here ("any signed-in user
// may read and write everything") would have REPLACED the ERP's rules the moment anyone ran `firebase deploy`
// from this folder, so this file now denies everything, and firebase.json no longer deploys rules at all.
// Do not deploy rules from here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
